<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ─── Renderer ──────────────────────────────────────────────── -->
	<!-- Disable Impeller (heavy on low-end / Intel simulator) — use Skia -->
	<key>FLTEnableImpeller</key>
	<false/>

	<!-- ─── Share Extension URL scheme ─────────────────────────────── -->
	<!-- receive_sharing_intent redirects from the Share Extension back
	     into MedShelf via this custom scheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>

	<!-- ─── Standard Flutter / app metadata ────────────────────────── -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedShelf</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>medshelf</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ─── Privacy permission strings (App Store Review reads these) ─── -->
	<!-- Apple rejects vague reasons — each string must explain WHEN and WHY. -->

	<key>NSCameraUsageDescription</key>
	<string>MedShelf uses the camera only when you tap the Scan button to digitise a paper document. Edge detection and contrast enhancement happen on your device — no images are uploaded.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>MedShelf needs microphone access only if you record audio notes for a study topic. Recordings stay on your device.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>MedShelf accesses your photo library only when you choose Import Files and pick a medical image. Photos you do not select are never read.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MedShelf saves shared documents back to your photo library when you choose to export them.</string>

	<key>NSAppleMusicUsageDescription</key>
	<string>MedShelf does not access Apple Music. This permission is required by a media-import library used for selecting files from your device.</string>

	<key>NSDocumentsFolderUsageDescription</key>
	<string>MedShelf reads documents you pick from the Files app to import them into your medical study library.</string>

	<key>NSFileProviderDomainUsageDescription</key>
	<string>MedShelf organises your imported study material into folders that show up under Files › On My iPhone › MedShelf.</string>

	<!-- Files-app integration — exposes MedShelf's documents folder so users
	     can browse it from Apple's Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- ─── Document type / share-target wiring ─────────────────────── -->
	<!-- Lets other apps (Mail, WhatsApp, Safari) hand a file to MedShelf via
	     "Share → MedShelf" or "Open with MedShelf". Mirrors the Android
	     SEND / SEND_MULTIPLE intent filters. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>All Files</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
				<string>public.image</string>
				<string>public.movie</string>
				<string>public.audio</string>
				<string>com.adobe.pdf</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>org.openxmlformats.presentationml.presentation</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>com.microsoft.word.doc</string>
				<string>com.microsoft.powerpoint.ppt</string>
				<string>com.microsoft.excel.xls</string>
				<string>public.plain-text</string>
				<string>public.rtf</string>
			</array>
		</dict>
	</array>

	<!-- ─── Scene + UI configuration ──────────────────────────────── -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Apple's iOS 17+ privacy nutrition labels infer most of these from
	     usage descriptions, but adding ITSAppUsesNonExemptEncryption=false
	     skips an export-compliance step at every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
