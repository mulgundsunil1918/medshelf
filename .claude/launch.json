{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "MedShelf Web Preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npx", "serve", "build\\web", "-l", "3000", "--no-clipboard"],
      "port": 3000
